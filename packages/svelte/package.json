{
  "name": "@xui/svelte",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@xui/core": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "jsdom": "^26.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm --filter @xui/core build && pnpm build && vitest run"
  }
}
