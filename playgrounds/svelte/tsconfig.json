{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@xui/svelte": ["../../packages/svelte/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "*.config.*"]
